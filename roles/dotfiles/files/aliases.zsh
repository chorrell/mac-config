# Common aliases
alias ll='ls -lah'
alias la='ls -lA'
alias l='ls -CF'

# Git aliases
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gpl='git pull'
alias gb='git branch'
alias gch='git checkout'
alias gd='git diff'
alias glog='git log --oneline --all --graph'

# Directory navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ~='cd ~'

# Utilities
alias c='clear'
alias h='history'
alias grep='grep --color=auto'

# Development
alias ansible-lint='ansible-lint --strict'
alias ansible-syntax='ansible-playbook --syntax-check'
